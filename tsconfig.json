{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2016",                        /* JavaScript version to compile to */
    "module": "commonjs",                      /* Node.js module system */
    "rootDir": "./src",                        /* Source code folder */
    "outDir": "./dist",                        /* Compiled JS output folder */
    "esModuleInterop": true,                   /* Allows import express from "express" */
    "forceConsistentCasingInFileNames": true, /* File name consistency */
    "strict": true,                            /* Enable all strict type-checking options */
    "skipLibCheck": true,                      /* Skip type checking for all .d.ts files */
    "sourceMap": true                          /* Generate source maps */
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
